{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Identity API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Ayush360.Identity.Api/bin/Debug/net10.0/Ayush360.Identity.Api.dll",
      "cwd": "${workspaceFolder}/src/Ayush360.Identity.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7263;http://localhost:5077"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "HMS API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Ayush360.Hms.Api/bin/Debug/net10.0/Ayush360.Hms.Api.dll",
      "cwd": "${workspaceFolder}/src/Ayush360.Hms.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7109;http://localhost:5041"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "compounds": [
    {
      "name": "Identity + HMS",
      "configurations": [
        "Identity API",
        "HMS API"
      ],
      "preLaunchTask": "build",
      "stopAll": true
    }
  ]
}
